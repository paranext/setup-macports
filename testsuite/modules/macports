: ${TOPLEVELDIR:=$(git rev-parse --show-toplevel)}
: ${subrdir:=${TOPLEVELDIR}/subr}

. "${subrdir}/stdlib.sh"
. "${subrdir}/macports.sh"
. "${subrdir}/testsuite.sh"

# The tests below run in a dedicated working directory, so the ports
# tree synchronisation can be exercised without touching a real
# MacPorts installation and without waiting for the network.

# Each attempt is recorded with its arguments, one per line, so the
# tests can count attempts and check how each one was made.
assume_that_port_sync_always_fails()
{
    stub_sleep

    sudo()
    (
	printf '%s\n' "$*" >> 'attempts'
	exit 1
    )
}

assume_that_port_sync_succeeds_on_attempt()
{
    successful_attempt="$1"
    stub_sleep

    sudo()
    (
	printf '%s\n' "$*" >> 'attempts'
	if [ "$(wc -l < 'attempts')" -lt "${successful_attempt}" ]; then
	    exit 1
	fi
	exit 0
    )
}

stub_sleep()
{
    sleep()
    (
	printf '%s\n' "$1" >> 'delays'
	exit 0
    )
}

# The tests run without root, so sudo just runs its command.
assume_that_sudo_is_not_needed()
{
    sudo()
    {
	"$@"
    }
}

assume_a_macports_configuration()
{
    mkdir -p 'etc/macports'
    cat > 'etc/macports/macports.conf' <<'CONFIG'
prefix			/opt/local
# Options to pass to rsync when fetching MacPorts base and the ports tree.
#rsync_options		-rtzvl --delete-after
build_arch		arm64
CONFIG
}

count_attempts()
(
    if [ -f 'attempts' ]; then
	wc -l < 'attempts' | tr -d ' '
    else
	printf '0\n'
    fi
)

assert_that_a_successful_synchronisation_is_not_retried()
(
    assume_that_port_sync_succeeds_on_attempt 1
    sync_ports
    exitcode="$?"
    set -e
    test "${exitcode}" -eq 0
    test "$(count_attempts)" -eq 1
)

assert_that_a_failed_synchronisation_is_retried()
(
    assume_that_port_sync_succeeds_on_attempt 3
    sync_ports
    exitcode="$?"
    set -e
    test "${exitcode}" -eq 0
    test "$(count_attempts)" -eq 3
)

assert_that_synchronisation_gives_up_after_the_last_attempt()
(
    macports_sync_attempts='4'
    assume_that_port_sync_always_fails
    ( sync_ports )
    exitcode="$?"
    set -e
    test "${exitcode}" -ne 0
    test "$(count_attempts)" -eq 4
)

assert_that_synchronisation_waits_between_attempts()
(
    macports_sync_attempts='3'
    assume_that_port_sync_always_fails
    ( sync_ports )
    set -e
    # One delay fewer than attempts: we do not wait after giving up.
    test "$(wc -l < 'delays' | tr -d ' ')" -eq 2
    # Delays increase, so a mirror under load is given more time.
    test "$(sed -n 1p 'delays')" -lt "$(sed -n 2p 'delays')"
)

# Debug output is costly in the log, so it is only asked for on the
# last attempt, where a persistent failure needs something to triage.
assert_that_only_the_last_attempt_asks_for_debug_output()
(
    macports_sync_attempts='3'
    assume_that_port_sync_always_fails
    ( sync_ports )
    set -e
    test "$(grep -c -- '-d' 'attempts')" -eq 1
    tail -n 1 'attempts' | grep -q -- '-d'
)

assert_that_a_first_attempt_success_asks_for_no_debug_output()
(
    macports_sync_attempts='4'
    assume_that_port_sync_succeeds_on_attempt 1
    sync_ports
    set -e
    ! grep -q -- '-d' 'attempts'
)

# A number of attempts that is not a number would otherwise never
# satisfy the comparison ending the loop. The stub succeeds after a
# few attempts so that a regression fails instead of hanging.
assert_that_an_invalid_number_of_attempts_is_rejected()
(
    macports_sync_attempts='four'
    assume_that_port_sync_succeeds_on_attempt 5
    ( sync_ports )
    exitcode="$?"
    set -e
    test "${exitcode}" -ne 0
    test "$(count_attempts)" -eq 0
)

assert_that_rsync_options_are_written()
(
    macports_prefix="$(pwd)"
    assume_that_sudo_is_not_needed
    assume_a_macports_configuration
    write_rsync_options
    set -e
    grep -q '^rsync_options .*--timeout=' 'etc/macports/macports.conf'
)

# We replace the rsync_options setting wholesale, so the flags MacPorts
# itself defaults to have to be carried over: dropping -l in
# particular would stop symlinks in the ports tree being copied.
assert_that_rsync_options_keep_the_macports_defaults()
(
    macports_prefix="$(pwd)"
    assume_that_sudo_is_not_needed
    assume_a_macports_configuration
    write_rsync_options
    set -e
    grep -q '^rsync_options -rtzvl --delete-after' 'etc/macports/macports.conf'
)

# MacPorts only installs its default configuration when there is none,
# so creating a file holding only rsync_options would lose every
# other default setting.
assert_that_rsync_options_need_a_configuration()
(
    macports_prefix="$(pwd)"
    assume_that_sudo_is_not_needed
    mkdir -p 'etc/macports'
    ( write_rsync_options )
    exitcode="$?"
    set -e
    test "${exitcode}" -ne 0
    test ! -e 'etc/macports/macports.conf'
)

assert_that_an_unreadable_configuration_is_left_alone()
(
    if [ "$(id -u)" -eq 0 ]; then
	# Root reads the file regardless of its mode.
	exit 0
    fi
    macports_prefix="$(pwd)"
    assume_that_sudo_is_not_needed
    assume_a_macports_configuration
    cp 'etc/macports/macports.conf' 'expected'
    chmod 000 'etc/macports/macports.conf'
    ( write_rsync_options )
    exitcode="$?"
    chmod 644 'etc/macports/macports.conf'
    set -e
    test "${exitcode}" -ne 0
    cmp -s 'expected' 'etc/macports/macports.conf'
)

# Configured rsync options are only useful if the rsync that MacPorts
# actually runs accepts them, and support differs across macOS
# versions: macOS 14 ships rsync 2.6.9, which has no --contimeout,
# while recent versions ship openrsync, which does. CI no longer has a
# macOS 14 runner, so no runner executes rsync 2.6.9. Instead, every
# configured option is checked against options known to be accepted
# by both implementations. Extend the list only after checking an
# option against rsync 2.6.9 by hand.
assert_that_rsync_options_are_accepted_by_rsync_2_6_9()
(
    set -e
    for option in ${macports_rsync_options}; do
	case "${option}" in
	    --delete-after|--timeout=[0-9]*)
		continue
		;;
	    --*)
		wlog 'Error' '%s: Not known to be accepted by rsync 2.6.9.' "${option}"
		false
		;;
	    -*)
		# Bundled short options: r, t, z, v and l only.
		test -z "$(printf '%s' "${option#-}" | tr -d 'rtzvl')" || {
		    wlog 'Error' '%s: Not known to be accepted by rsync 2.6.9.' "${option}"
		    false
		}
		;;
	    *)
		wlog 'Error' '%s: Not known to be accepted by rsync 2.6.9.' "${option}"
		false
		;;
	esac
    done
)

# The check above relies on a list of options. This one runs the rsync
# of the current runner, so it also catches an option that the list
# accepts by mistake.
assert_that_rsync_accepts_the_configured_options()
(
    rsync_program='/usr/bin/rsync'
    if [ ! -x "${rsync_program}" ]; then
	rsync_program=$(command -v rsync) || exit 0
    fi

    mkdir -p 'src' 'dst'
    : > 'src/a'
    output=$("${rsync_program}" ${macports_rsync_options} 'src/' 'dst/' 2>&1)

    set -e
    # Each implementation words this differently: rsync 2.6.9 says
    # "unknown option", openrsync says "unrecognized option", and both
    # print a usage summary when they reject an argument.
    if printf '%s' "${output}" | grep -i -E -q\
	    'unrecognized option|unknown option|invalid option|is invalid|^usage: rsync'; then
	wlog 'Error' '%s rejected the configured options \047%s\047: %s'\
	     "${rsync_program}" "${macports_rsync_options}" "${output}"
	false
    fi
)

assert_that_existing_rsync_options_are_replaced()
(
    macports_prefix="$(pwd)"
    assume_that_sudo_is_not_needed
    mkdir -p 'etc/macports'
    cat > 'etc/macports/macports.conf' <<'CONFIG'
prefix			/opt/local
#rsync_options		-rtzv --delete-after
rsync_options		-rtzv --delete-after
rsync_options
build_arch		arm64
CONFIG
    write_rsync_options
    set -e
    # The other settings are left alone.
    grep -q '^prefix' 'etc/macports/macports.conf'
    grep -q '^build_arch' 'etc/macports/macports.conf'
    # Exactly one rsync_options setting is left, and it is ours.
    test "$(grep -c 'rsync_options' 'etc/macports/macports.conf')" -eq 1
    grep -q '^rsync_options .*--timeout=' 'etc/macports/macports.conf'
)

testsuite_main\
    assert_that_a_successful_synchronisation_is_not_retried\
    assert_that_a_failed_synchronisation_is_retried\
    assert_that_synchronisation_gives_up_after_the_last_attempt\
    assert_that_synchronisation_waits_between_attempts\
    assert_that_only_the_last_attempt_asks_for_debug_output\
    assert_that_a_first_attempt_success_asks_for_no_debug_output\
    assert_that_an_invalid_number_of_attempts_is_rejected\
    assert_that_rsync_options_are_written\
    assert_that_rsync_options_keep_the_macports_defaults\
    assert_that_rsync_options_are_accepted_by_rsync_2_6_9\
    assert_that_rsync_options_need_a_configuration\
    assert_that_an_unreadable_configuration_is_left_alone\
    assert_that_rsync_accepts_the_configured_options\
    assert_that_existing_rsync_options_are_replaced\

# End of file `macports'
